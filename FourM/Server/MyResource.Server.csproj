<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <DebugType>portable</DebugType>
        <TargetName>$(AssemblyName).net</TargetName>
        <DefineConstants>SERVER</DefineConstants>
        <LangVersion>latest</LangVersion>
        <ResourceOutputPath>$(MSBuildProjectDirectory)\..\resource\</ResourceOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>bin\Release</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CitizenFX.Core.Server" Version="1.0.26803" />

        <Compile Include="../Shared/**/*.cs" />
    </ItemGroup>

    <Target Name="CopyServerResourceFiles" AfterTargets="Build">
        <ItemGroup>
            <BuildOutputFiles Include="$(TargetDir)**\*.*" />
        </ItemGroup>
        <MakeDir Directories="$(ResourceOutputPath)" />
        <Copy SourceFiles="@(BuildOutputFiles)" DestinationFolder="$(ResourceOutputPath)%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>
  
