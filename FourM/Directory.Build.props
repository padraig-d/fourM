<Project>
    <PropertyGroup>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;$(MSBuildThisFileDirectory)artifacts\**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
